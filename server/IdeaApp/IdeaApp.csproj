<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <!--
      运行时包版本与上面钉死的 ILCompiler 保持一致（10.0.14），避免日后 AOT 下的 SQLite 互操作 /
      SSE 问题因为版本错配而难以归因。
      只在显式指定 RID 时生效（即发布场景：dotnet publish -r linux-x64）：SDK 内置的运行时包是 10.0.13，
      而本机 SDK 使用的发行版专属 apphost 包（Microsoft.NETCore.App.Host.fedora.44-x64）只随 SDK 提供
      10.0.13，nuget.org 上并不存在该包 —— 无 RID 的构建若强行用 10.0.14，restore 会直接 NU1101 失败。
    -->
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' != ''">10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SDK 10.0.113 内置的 ILCompiler 是 10.0.13，命中 advisory GHSA-p3jp-9v83-76w9（Brotli 解码器越界写，
      修复版本为 10.0.14）。Directory.Build.props 开启了 TreatWarningsAsErrors，NU1903 会被升级为错误，
      导致 restore 直接失败。显式把 ILCompiler 提到修复版本 10.0.14。
      升级 SDK 到内置 10.0.14+ 的版本后可以删掉这一行。
    -->
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler" ILCompilerPackVersion="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure/schema.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试要能调用 internal 的测试缝（见 Domain/MonotonicGuid.cs）。 -->
    <InternalsVisibleTo Include="IdeaApp.Tests" />
  </ItemGroup>

</Project>
